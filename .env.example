# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Auth (NextAuth)
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Mercado Pago — conta da própria plataforma (usada como fallback para
# tenants que ainda não conectaram a própria conta via OAuth)
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""

# Mercado Pago — Aplicação Marketplace (necessária pro fluxo de OAuth da
# Fase 3: onboarding, split de pagamentos via application_fee/marketplace_fee)
MERCADOPAGO_CLIENT_ID=""
MERCADOPAGO_CLIENT_SECRET=""

# Percentual de comissão da Muno sobre pedidos de tenants já conectados
PLATFORM_COMMISSION_PERCENT="5"

# Segredo do Vercel Cron (job diário de renovação de token) — a Vercel
# preenche automaticamente o header Authorization com esse valor quando o
# cron dispara; localmente, gere qualquer string aleatória.
CRON_SECRET=""

# Chave de criptografia (AES-256-GCM) dos tokens do Mercado Pago em
# PaymentConnection — 32 bytes em hex. Gere com: openssl rand -hex 32
# Trocar essa chave invalida todas as conexões existentes (não dá pra
# descriptografar os tokens já salvos), então trate como segredo rotativo
# com cuidado — nunca troque em produção sem migrar os dados antes.
PAYMENT_TOKEN_ENCRYPTION_KEY=""

# Asaas da plataforma — a Muno cobrando o restaurante. Não confundir com a
# credencial por tenant de PaymentConnection.
ASAAS_API_KEY=""
ASAAS_ENV="sandbox"
ASAAS_WEBHOOK_TOKEN=""

# Email (Resend)
RESEND_API_KEY=""

# AI (Groq - gratuito em console.groq.com, 14.400 req/dia)
GROQ_API_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Multi-tenant: domínio raiz usado para resolver o tenant pelo subdomínio
# (ex.: restaurante-slug.muno.app). Em dev, deixe como localhost:3000 —
# nesse caso o host sem subdomínio cai automaticamente no tenant "default".
ROOT_DOMAIN="localhost:3000"
