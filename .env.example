# Database (Supabase PostgreSQL)
# DATABASE_URL é a conexão da aplicação (pooler); DIRECT_URL é usada só pelo
# Prisma para migrar. Em produção, DATABASE_URL leva ?pgbouncer=true&connection_limit=1
# (cada função serverless abre conexões demais sem o limite). Acrescente
# &pool_timeout=20&connect_timeout=15 para uma consulta presa não segurar a função
# até o limite da plataforma. Há um pool só por instância: prisma e prismaUnscoped
# compartilham o mesmo cliente base.
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Auth (NextAuth). O Auth.js v5 lê AUTH_SECRET; NEXTAUTH_SECRET segue como
# apelido aceito. Defina um dos dois (openssl rand -base64 32).
AUTH_SECRET=
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Segredo do Vercel Cron (job diário de cobrança da assinatura) — a Vercel
# preenche automaticamente o header Authorization com esse valor quando o
# cron dispara; localmente, gere qualquer string aleatória.
CRON_SECRET=""

# Chave de criptografia (AES-256-GCM) das credenciais de gateway em
# PaymentConnection — 32 bytes em hex. Gere com: openssl rand -hex 32
# Trocar essa chave invalida todas as conexões existentes (não dá pra
# descriptografar os tokens já salvos), então trate como segredo rotativo
# com cuidado — nunca troque em produção sem migrar os dados antes.
PAYMENT_TOKEN_ENCRYPTION_KEY=""

# Asaas da plataforma — a Muno cobrando o restaurante. Não confundir com a
# credencial por tenant de PaymentConnection.
#
# A chave do Asaas começa com $, e o $ PRECISA vir escapado como \$ aqui.
# O carregador de .env do Next expande variáveis: um $ solto vira referência a
# uma variável que não existe, e a chave chega VAZIA na aplicação — enquanto
# um curl lendo o arquivo direto funciona, porque não passa pelo expansor.
# Aspas (simples ou duplas) não protegem; só a barra invertida.
ASAAS_API_KEY=""
ASAAS_ENV="sandbox"
ASAAS_WEBHOOK_TOKEN=""

# Email (Resend). RESEND_FROM_EMAIL precisa ser de um domínio verificado no
# Resend: sem ele o remetente cai em onboarding@resend.dev, que só entrega ao
# dono da conta, e o cliente que pagou nunca recebe o link de senha.
RESEND_FROM_EMAIL=
RESEND_API_KEY=""

# Vercel Blob (backup do banco). Preenchido por `vercel env pull`.
BLOB_READ_WRITE_TOKEN=

# Alarme de erros (opcional): URL de um webhook que aceite {"text": "..."}
# (Slack, Discord). Recebe falhas de cron, webhook, provisionamento e e-mail.
# Sem ela, os erros só vão para o log (JSON, uma linha cada).
ERROR_WEBHOOK_URL=

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Multi-tenant: domínio raiz usado para resolver o tenant pelo subdomínio
# (ex.: <slug>.munoapp.com.br). Em dev, deixe como localhost:3000. Desde
# 10/08/2026 o host SEM subdomínio não cai mais no tenant "default" — ele
# serve a landing de vendas (public/vendas/), em dev e produção igual. Para
# abrir o restaurante do seed em desenvolvimento, use default.localhost:3000.
# Ver AGENTS.md, seção "Os domínios".
ROOT_DOMAIN="localhost:3000"

# Origens permitidas para a landing de vendas (outro repositório) gravar lead
# via /api/leads/publico. Lista separada por vírgula, mesmo formato do
# ROOT_DOMAIN acima. Sem esta variável, produção recusa toda origem
# cross-site — falha fechada, e a landing para de gravar lead sem nada
# quebrar visivelmente. Ver AGENTS.md, "A captação de lead atravessa os dois
# repositórios".
LANDING_ORIGIN="https://munoapp.com.br,https://www.munoapp.com.br,https://join.munoapp.com.br"

# Console da plataforma (admin.<domínio>): lista de IPs permitidos, separados por
# vírgula. Vazia = qualquer origem (só e-mail e senha). Os demais recebem 404.
# O console enxerga todos os restaurantes; vale preencher com o IP fixo do
# escritório/casa enquanto não houver segundo fator.
PLATFORM_ALLOWED_IPS=

# Retenção: anonimiza nome, telefone, endereço e observações dos pedidos mais
# antigos que este número de meses (o pedido em si fica). Vazia = desligada. O
# prazo é decisão de negócio e jurídica.
RETENCAO_PEDIDOS_MESES=

# Segredo dos nomes de canal de tempo real. Opcional: sem ele deriva de
# PAYMENT_TOKEN_ENCRYPTION_KEY (e trocar uma muda a outra).
REALTIME_TOPIC_SECRET=

# Chave de criptografia ANTERIOR, só durante uma rotação (ver AGENTS.md).
PAYMENT_TOKEN_ENCRYPTION_KEY_ANTERIOR=
