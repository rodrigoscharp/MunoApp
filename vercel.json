{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "regions": [
    "gru1"
  ],
  "crons": [
    {
      "path": "/api/cron/assinaturas",
      "schedule": "0 9 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.munoapp.com.br"
        }
      ],
      "destination": "https://munoapp.com.br/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "join.munoapp.com.br"
        }
      ],
      "destination": "https://munoapp.com.br/$1",
      "permanent": true
    }
  ]
}
