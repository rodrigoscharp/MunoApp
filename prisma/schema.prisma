generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PlanoTenant {
  MEMBRO
  MEMBRO_MESA_QR
}

model Tenant {
  id        String      @id @default(cuid())
  nome      String
  slug      String      @unique
  plano     PlanoTenant @default(MEMBRO)
  status    String      @default("active")
  createdAt DateTime    @default(now())

  users               User[]
  categories          Category[]
  menuItems           MenuItem[]
  orders              Order[]
  orderItems          OrderItem[]
  deliveryTrackings   DeliveryTracking[]
  tables              Table[]
  payments            Payment[]
  settings            Setting[]
  deliveryZones       DeliveryZone[]
  chatMessages        ChatMessage[]
  paymentConnections  PaymentConnection[]
  passwordResetTokens PasswordResetToken[]
  coupons             Coupon[]
  lead                Lead?
  assinatura          Assinatura?
}

model PaymentConnection {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  provider          String   // 'mercado_pago' | 'asaas'
  credentials       String   // JSON criptografado (AES-256-GCM), ver src/lib/payments/credentials.ts
  externalAccountId String?  // id da conta no gateway, quando a validação devolver
  status            String   // 'pending_webhook' | 'active' | 'invalid' | 'disabled'
  lastCheckedAt     DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([tenantId, provider])
  @@index([tenantId])
}

model User {
  id                String             @id @default(cuid())
  tenantId          String
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  name              String
  email             String
  password          String?
  role              Role               @default(CUSTOMER)
  orders            Order[]
  motoboyOrders     Order[]            @relation("MotoboyOrders")
  deliveryTrackings DeliveryTracking[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
}

enum Role {
  CUSTOMER
  ADMIN
  KITCHEN
  MOTOBOY
}

model Category {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  name      String
  slug      String
  position  Int        @default(0)
  items     MenuItem[]
  createdAt DateTime   @default(now())

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model MenuItem {
  id          String      @id @default(cuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  name        String
  description String?
  price       Decimal     @db.Decimal(10, 2)
  imageUrl    String?
  available   Boolean     @default(true)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([tenantId])
  @@index([categoryId])
}

model Order {
  id                  String            @id @default(cuid())
  tenantId            String
  tenant              Tenant            @relation(fields: [tenantId], references: [id])
  status              OrderStatus       @default(PENDING)
  paymentMethod       PaymentMethod
  paymentStatus       PaymentStatus     @default(UNPAID)
  mpPaymentId         String?
  total               Decimal           @db.Decimal(10, 2)
  notes               String?
  customerName        String?
  customerPhone       String?
  deliveryType        DeliveryType      @default(PICKUP)
  deliveryAddress     String?
  deliveryFee         Decimal           @default(0) @db.Decimal(10, 2)
  // total = subtotal dos itens + deliveryFee - discount. O subtotal não tem
  // coluna própria: ele sai de (total - deliveryFee + discount), exato inclusive
  // nos pedidos anteriores ao cupom, onde discount é 0.
  discount            Decimal           @default(0) @db.Decimal(10, 2)
  couponId            String?
  coupon              Coupon?           @relation(fields: [couponId], references: [id], onDelete: SetNull)
  // Cópia do código no momento do pedido: sobrevive à exclusão do cupom, que é
  // o que mantém o recibo e o histórico legíveis depois.
  couponCode          String?
  estimatedDeliveryAt DateTime?
  userId              String?
  user                User?             @relation(fields: [userId], references: [id])
  motoboyId           String?
  motoboy             User?             @relation("MotoboyOrders", fields: [motoboyId], references: [id])
  tableId             String?
  table               Table?            @relation(fields: [tableId], references: [id])
  deliveryTracking    DeliveryTracking?
  items               OrderItem[]
  chatMessages        ChatMessage[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  // As três consultas quentes. Cada uma começa por tenantId, então elas também
  // atendem o filtro automático da extensão do Prisma — por isso o @@index
  // solto em [tenantId] foi removido: virou prefixo redundante.
  @@index([tenantId, status, createdAt]) // fila da cozinha
  @@index([tenantId, userId, createdAt]) // histórico do cliente
  @@index([tenantId, status, deliveryType]) // fila do motoboy
  @@index([motoboyId])
  @@index([tableId])
  @@index([couponId, userId]) // "já usei este cupom?" na validação do checkout
}

model Table {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  number    Int
  name      String?
  token     String    @default(cuid())
  active    Boolean   @default(true)
  posX      Float?
  posY      Float?
  orders    Order[]
  payments  Payment[]
  createdAt DateTime  @default(now())

  @@unique([tenantId, number])
  @@unique([tenantId, token])
  @@index([tenantId])
}

model Payment {
  id        String        @id @default(cuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  tableId   String?
  table     Table?        @relation(fields: [tableId], references: [id])
  method    PaymentMethod
  amount    Decimal       @db.Decimal(10, 2)
  createdAt DateTime      @default(now())

  @@index([tenantId])
  @@index([tableId])
}

model Setting {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  email     String
  token     String   @unique @default(cuid())
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([tenantId])
}

model DeliveryTracking {
  id        String   @id @default(cuid())
  // Mesma razão do tenantId em OrderItem: é a posição GPS ao vivo do motoboy,
  // e sem a coluna qualquer id de pedido lê o rastreamento de outro restaurante.
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  motoboyId String
  motoboy   User     @relation(fields: [motoboyId], references: [id])
  lat       Float
  lng       Float
  startedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([motoboyId])
}

enum DeliveryType {
  PICKUP
  DELIVERY
  DINE_IN
}

model OrderItem {
  id         String   @id @default(cuid())
  // Redundante com order.tenantId de propósito: sem a coluna aqui, este model
  // fica fora de TENANT_SCOPED_MODELS e agregações diretas (ex.: o groupBy do
  // topItems em /api/analytics) somam os itens de todos os restaurantes.
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  quantity   Int
  unitPrice  Decimal  @db.Decimal(10, 2)
  notes      String?
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([tenantId])
  @@index([orderId])
  @@index([menuItemId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PREPARATION
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  CASH
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

model DeliveryZone {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  price     Decimal  @db.Decimal(10, 2)
  active    Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Coupon {
  id         String     @id @default(cuid())
  tenantId   String
  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  code       String     // sempre gravado em maiúsculas e sem espaços
  type       CouponType
  // Porcentagem quando PERCENT, reais quando FIXED, ignorado em FREE_SHIPPING.
  value      Decimal    @default(0) @db.Decimal(10, 2)
  // Comparado contra o subtotal dos itens, sem o frete.
  minOrder   Decimal    @default(0) @db.Decimal(10, 2)
  validFrom  DateTime?
  validUntil DateTime?
  active     Boolean    @default(true)
  orders     Order[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
}

enum CouponType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

model ChatMessage {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderRole String   // "CUSTOMER" | "ADMIN"
  senderId   String?
  senderName String?
  content    String
  createdAt  DateTime @default(now())

  @@index([orderId])
  @@index([tenantId])
}

// Login da área administrativa da plataforma, separado dos usuários de restaurante (User)
model PlatformAdmin {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

enum LeadStatus {
  NOVO
  CONTATADO
  NEGOCIACAO
  FECHADO
  PERDIDO
}

// Prospecção de restaurantes (CRM). tenantId é o vínculo com o cliente convertido, não um escopo multi-tenant
model Lead {
  id          String     @id @default(cuid())
  restaurante String
  contato     String?
  email       String?
  telefone    String?
  cidade      String?
  endereco    String?
  logoUrl     String?
  origem      String     @default("manual")
  // Nulável e sem default: lead digitado à mão fica sem plano, e isso é
  // informação — significa "não perguntei", não "não quis". Um default faria o
  // CRM afirmar sobre todo lead histórico algo que ninguém perguntou.
  // String livre, não enum: os dois repositórios são publicados separadamente,
  // e um enum transformaria a próxima mudança no select da landing em 400
  // silencioso, perdendo o lead.
  plano       String?
  status      LeadStatus @default(NOVO)
  motivoPerda String?
  tenantId    String?    @unique
  tenant      Tenant?    @relation(fields: [tenantId], references: [id])
  notas       LeadNote[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  texto     String
  createdAt DateTime @default(now())

  @@index([leadId])
}

enum AssinaturaStatus {
  ATIVA
  INADIMPLENTE
  BLOQUEADA
  CANCELADA
}

enum CobrancaStatus {
  PENDENTE
  PAGA
  VENCIDA
  CANCELADA
}

// Também usado por Inscricao (checkout self-service): o cliente escolhe o
// ciclo antes de existir Assinatura nenhuma.
enum Ciclo {
  MENSAL
  ANUAL
}

// Relação comercial entre a plataforma e o restaurante. Não é modelo
// tenant-scoped: quem lê é a plataforma, sempre por prismaUnscoped, como o Lead.
model Assinatura {
  id                  String           @id @default(cuid())
  tenantId            String           @unique
  tenant              Tenant           @relation(fields: [tenantId], references: [id])
  valorMensal         Decimal          @db.Decimal(10, 2)
  diaVencimento       Int
  // Primeiro vencimento. Durante a cortesia a assinatura existe e não cobra.
  inicioCobranca      DateTime
  ciclo               Ciclo            @default(MENSAL)
  // Presente = o Asaas cobra esta assinatura, e o cron NÃO gera cobrança para
  // ela. Nulo = cliente cobrado por PIX conferido na mão, como antes do
  // gateway. É este campo que impede dois relógios gerando a mesma dívida:
  // sem ele, o cron cria uma segunda cobrança que o Asaas nunca vai baixar, e
  // o cliente que pagou em dia é bloqueado pela régua em 15 dias mesmo assim.
  asaasSubscriptionId String?          @unique
  status              AssinaturaStatus @default(ATIVA)
  cobrancas           Cobranca[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

model Cobranca {
  id           String         @id @default(cuid())
  assinaturaId String
  assinatura   Assinatura     @relation(fields: [assinaturaId], references: [id])
  competencia  String
  valor        Decimal        @db.Decimal(10, 2)
  vencimento   DateTime
  status       CobrancaStatus @default(PENDENTE)
  pagoEm       DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  // A idempotência do job diário mora aqui, no banco, e não no código que
  // chama: rodar duas vezes no mesmo mês não gera duas cobranças.
  @@unique([assinaturaId, competencia])
  @@index([status, vencimento])
}
